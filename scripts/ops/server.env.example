# 复制为 .env.production 后填写真实值（该文件已在 .gitignore 中）
# 注意：systemd EnvironmentFile 里值不要加引号，引号会被当成值的一部分
NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1

# 应用与数据库同机：直接用 docker 网内地址，不开 5432 公网
DATABASE_URL=postgresql://<用户>:<密码>@172.20.0.2:5432/xingyi
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=形意拳体验预约 <booking@你的已验证域名>
NEXT_PUBLIC_SITE_URL=https://你的域名

# 生成：openssl rand -base64 48
AUTH_SECRET=
PAYMENT_WEBHOOK_SECRET=

HOLD_MINUTES=15
TZ_LABEL=Asia/Shanghai
