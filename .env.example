DATABASE_URL=
RESEND_API_KEY=
EMAIL_FROM="形意拳体验预约 <booking@你的已验证域名.com>"
EMAIL_REPLY_TO=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
AUTH_SECRET=
PAYMENT_WEBHOOK_SECRET=
HOLD_MINUTES=15
TZ_LABEL=Asia/Shanghai

# ---------------------------------------------------------------------------
# 支付渠道（详见 docs/PAYMENTS.md）
# 未配置的环境变量对应渠道不会出现在收银台；还需到后台「支付渠道」点击启用
# ---------------------------------------------------------------------------
# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal（PAYPAL_MODE=live 才真实收款，默认 sandbox）
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox

# 微信支付 APIv3 · Native 扫码
WECHAT_APPID=
WECHAT_MCHID=
WECHAT_SERIAL_NO=
WECHAT_API_V3_KEY=
# 商户私钥 PEM（含 \n 也可），或填 WECHAT_PRIVATE_KEY_PATH 指向文件
WECHAT_PRIVATE_KEY=
WECHAT_PRIVATE_KEY_PATH=
# 微信支付平台证书 PEM，或填 WECHAT_PLATFORM_CERT_PATH 指向文件
WECHAT_PLATFORM_CERT=
WECHAT_PLATFORM_CERT_PATH=
